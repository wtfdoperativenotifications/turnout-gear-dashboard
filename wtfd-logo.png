name = "turnout-gear-dashboard"
main = "src/worker.ts"
compatibility_date = "2026-08-01"

[build]
command = "npm run build"

[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[vars]
MAINTENANCE_LOOKAHEAD_DAYS = "30"
TURNOUT_CATEGORY_PATTERN = "turnout|coat|pant|trouser|bunker"

# Version 6 first attempts a direct OperativeIQ connection when OPERATIVE_BASE_URL is configured.
# Set the direct endpoint variables in Cloudflare, not in this file, once confirmed:
# OPERATIVE_BASE_URL = "https://your-operativeiq-api-host"
# OPERATIVE_TURNOUT_PATH = "/api/confirmed-turnout-or-assets-route"
# Optional enrichment routes:
# OPERATIVE_ASSIGNMENTS_PATH = "/api/confirmed-assignment-route"
# OPERATIVE_INSPECTIONS_PATH = "/api/confirmed-inspection-route"

# Temporary legacy fallback. It can be removed after the direct connection is verified.
TURNOUT_GEAR_SOURCE_URL = "https://wtfd-operative-preview.hartleywtfd.workers.dev/preview-turnout-gear"

# Secrets supported by the Worker:
# OPERATIVE_API_TOKEN (preferred), TURNOUT_GEAR_SOURCE_TOKEN (legacy),
# OPERATIVE_API_KEY, OPERATIVE_BASIC_AUTH, or OPERATIVE_AUTH_HEADER.
